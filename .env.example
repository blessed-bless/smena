BOT_TOKEN=replace_locally
BOT_USERNAME=your_bot_username
OWNER_TELEGRAM_ID=your_numeric_telegram_id
PUBLIC_URL=https://your-domain.example
PORT=8732
DATA_DIR=/var/lib/smena

# За nginx/Caddy: доверять X-Forwarded-For
TRUST_PROXY=0
# Вход мастеров аккаунтом YCLIENTS: партнёрский токен разработчика (маркетплейс YCLIENTS).
# Без него вход отключён, остаются приглашения и iCal-ссылка.
YCLIENTS_PARTNER_TOKEN=
# Секрет для шифрования токенов YCLIENTS в базе. Если не задан, используется BOT_TOKEN.
# Сменить его — значит разлогинить всех мастеров из YCLIENTS.
TOKEN_SECRET=
# Необязательно: токены для кабинета владельца без входа (прежний способ)
YCLIENTS_USER_TOKEN=
YCLIENTS_COMPANY_ID=
YCLIENTS_STAFF_ID=

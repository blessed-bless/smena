# Telegram bot token from @BotFather
BOT_TOKEN=replace_locally

# Bot username without @ (optional: filled from getMe when the bot starts)
BOT_USERNAME=your_bot_username

# Numeric Telegram user id of the owner
OWNER_TELEGRAM_ID=your_numeric_telegram_id

# Public HTTPS origin of this app (Telegram buttons and WebApp URL)
PUBLIC_URL=https://your-domain.example

# HTTP listen port (published to 127.0.0.1 in Docker)
PORT=8732

# SQLite data directory (snapshots live under DATA_DIR/snapshots)
DATA_DIR=/var/lib/smena

# Default calendar timezone for new installs is Europe/Moscow (in app code / Settings).
# Documented here for operators; the process reads timezone from SQLite settings.

# Behind nginx/Caddy: trust X-Forwarded-For for rate limits
TRUST_PROXY=0

# Optional: official YCLIENTS API (otherwise paste a Google Calendar iCal URL in Settings)
YCLIENTS_PARTNER_TOKEN=
YCLIENTS_USER_TOKEN=
YCLIENTS_COMPANY_ID=
YCLIENTS_STAFF_ID=
